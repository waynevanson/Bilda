  chore = Chore {
    description = "Vacuum"
    owner = "Wayne"
    completed
  }
  yes = True
  no = False
  # reassign to your hearts content!
  yes = "um hello"
  globl = './**/*.rs'
  imported = ./path/to/file.txt
  founded = ["sup" "bro" "my-man"]
  hello_world = ""
  d = { a b c }
  e: List<{ single = Int double = Int }> =
    on
      single = [1 2 3 4]
    do List.map
      double = f * 2
    in
      { single double }
  f = (
    name: String
    value: Int
  ) => "{name}-{value}"
  value = "hello"
in {
 value = {
    d: String = value
    ["sdsd"] = f("brothers" 3)
    [value] = "World!"
    ["Well {value}"]: "Earth!"
    ["Welp {value}"]: "Earth!"
 }
